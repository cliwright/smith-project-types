{
  "name": "repo/uv/workspace",
  "version": 1,
  "description": "uv workspace root environment",

  "tools": ["uv"],

  "working_dir": "project",

  "targets": {
    "setup": {
      "description": "Create the workspace venv and sync all workspace members",
      "steps": ["uv venv", "uv sync --extra dev"]
    },
    "clean": {
      "description": "Remove the workspace virtualenv",
      "steps": ["rm -rf .venv"]
    }
  }
}
